<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SnakeUi.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeUi"
    >
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="CustomBarBackgroundColor" Color="#2a2a3d"/>
            <Thickness x:Key="ContentMarginForCustomBar">0,32,0,0</Thickness>

            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#3b3b55"/>
            <SolidColorBrush x:Key="TextForegroundBrush" Color="#e0e0e0" />
            <SolidColorBrush x:Key="ViewBackgroundBrush" Color="#1e1e2f" />
          
            <x:Double x:Key="ButtonWidth">200</x:Double>
            <x:Double x:Key="HeaderFontSize">50</x:Double>
            <x:Double x:Key="ElementFontSize">36</x:Double>

        </ResourceDictionary>
    </Application.Resources>

</Application>
