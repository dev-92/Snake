<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SnakeUi.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeUi"
    >
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- Colors -->
                <ResourceDictionary Source="Resources/ColorThemes/DarkColorsTheme.xaml" />
                <ResourceDictionary Source="Resources/Brushes.xaml" />
                
                <!-- Styles -->
                <ResourceDictionary Source="ms-appx:///Resources/Styles/CustomButtonStyle.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Styles/CustomComboBox.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <!-- Other Propertys -->
            <x:Double x:Key="ButtonWidth">200</x:Double>
            <x:Double x:Key="HeaderFontSize">50</x:Double>
            <x:Double x:Key="ElementFontSize">36</x:Double>
            <x:Double x:Key="ComboBoxFontSize">20</x:Double>

            <Thickness x:Key="ContentMarginForCustomBar">0,32,0,0</Thickness>

   
        </ResourceDictionary>
    </Application.Resources>

</Application>
