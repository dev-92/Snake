<Window
    x:Class="SnakeUi.MVVM.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeUi.MVVM.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SnakeUi">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowLayout" KeyDown="CoreWindow_KeyDown">
        
        <!-- Custom TitleBar -->
        <Grid 
            x:Name="CustomTitleBar" 
            Height="32" 
            Background="#222" 
            VerticalAlignment="Top"
            >

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0">
                <Image 
                    Source="/Assets/snake_logo.png"
                    Width="24" 
                    Height="24"
                    />

                <TextBlock 
                    Text="Snake" 
                    Foreground="White" 
                    FontSize="16" 
                    VerticalAlignment="Center" 
                    Margin="8,0,0,0"
                    />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
