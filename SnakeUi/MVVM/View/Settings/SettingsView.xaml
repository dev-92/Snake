<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SnakeUi.MVVM.View.MainMenu.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeUi.MVVM.View.MainMenu"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:SnakeUi.MVVM.View.Settings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{StaticResource ContentMarginForCustomBar}"
          Background="{StaticResource ViewBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ============= HEADER ============= -->
        <TextBlock Text="Settings"
               Foreground="{StaticResource TextForegroundBrush}"
               FontSize="{StaticResource HeaderFontSize}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Grid.Row="0" />

        <!-- ============= CONTENT ============= -->
        <ScrollViewer Grid.Row="1">
            <StackPanel HorizontalAlignment="Center">

                <settings:DesignSettingsView x:Name="DesignSettingsSection" />

                <settings:AudioSettingsView x:Name="AudioSettingsSection" />

                <settings:OtherSettingsView x:Name="OtherSettingsSection" />

                <!-- Back Button -->
                <Button Content="Back"
                    Click="Back_Click"
                    Style="{StaticResource CustomButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
