<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SnakeUi.MVVM.View.Settings.DesignSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeUi.MVVM.View.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ========================================== -->
        <!-- ============= DESIGN_SETTINGS ============= -->
        <!-- ========================================== -->

        <Grid Margin="0,5" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource FirstColWidth}"/>
                <ColumnDefinition Width="{StaticResource SecColWidth}"/>
                <ColumnDefinition Width="{StaticResource ThdColWidth}"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============= HEADER ============= -->
            <TextBlock 
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 Grid.Row="0"
                 Text="Design"
                 Foreground="{StaticResource TextForegroundBrush}"
                 FontSize="{StaticResource ElementFontSize}"
                 Margin="{StaticResource NewCategoryMargin}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

            <!-- ============= CELL_SHAPE ============= -->
            <TextBlock Grid.Column="0"
                    Grid.Row="1"
                    Text="Cell Shape"
                    Foreground="{StaticResource TextForegroundBrush}"
                    FontSize="{StaticResource ElementFontSize}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left" />

            <Slider x:Name="CellShapeSlider"
                        Grid.Column="1"
                        Grid.Row="1"
                        Minimum="100"
                        Maximum="1000"
                        Margin="{StaticResource SliderMargin}"
                        Value="100"
                        TickFrequency="10"
                        TickPlacement="BottomRight"
                        StepFrequency="1"
                        Width="200"
                        ValueChanged="CellShapeSlider_ValueChanged"/>

            <TextBlock Grid.Column="2"
                            Grid.Row="1"
                            Text="upcoming"
                            Foreground="{StaticResource TextForegroundBrush}"
                            FontSize="{StaticResource ElementFontSize}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />

            <!-- ============= GRID_SIZE ============= -->
            <TextBlock Grid.Column="0"
                            Grid.Row="2"
                            Text="Grid Size"
                            Foreground="{StaticResource TextForegroundBrush}"
                            FontSize="{StaticResource ElementFontSize}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />

            <Slider x:Name="GridSizeSlider"
                         Grid.Column="1"
                         Grid.Row="2"
                         Minimum="100"
                         Maximum="1000"
                         Margin="{StaticResource SliderMargin}"
                         Value="100"
                         TickFrequency="10"
                         TickPlacement="BottomRight"
                         StepFrequency="1"
                         Width="200"
                         ValueChanged="GridSizeSlider_ValueChanged"/>

            <TextBlock Grid.Column="2"
                            Grid.Row="2"
                            Text="upcoming"
                            Foreground="{StaticResource TextForegroundBrush}"
                            FontSize="{StaticResource ElementFontSize}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />

            <!-- ============= THEME ============= -->
            <TextBlock Grid.Column="0"
                            Grid.Row="3"
                            Text="Theme"
                            Foreground="{StaticResource TextForegroundBrush}"
                            FontSize="{StaticResource ElementFontSize}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />

            <ComboBox Grid.Column="1"
                           Grid.Row="3"
                           x:Name="ThemeSelector"
                           Style="{StaticResource CustomComboBox}"    
                           VerticalAlignment="Center"
                           SelectionChanged="ThemeSelector_SelectionChanged">

                <!-- First content is empty because the first element does not show hover color -->
                <!-- The empty ComboBoxItem is not shown on the drop down so this fixes the issue -->
                <ComboBoxItem Content="" />
                <ComboBoxItem Content="Dark" />
                <ComboBoxItem Content="Retro" />
                <ComboBoxItem Content="OceanTech" />
                <ComboBoxItem Content="Cyberpunk" />
            </ComboBox>
        </Grid>
    </Grid>
</UserControl>
