<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SnakeUi.MVVM.View.Settings.OtherSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeUi.MVVM.View.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ========================================== -->
        <!-- ============= OTHER_SETTINGS ============= -->
        <!-- ========================================== -->

        <Grid Margin="0,5" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource FirstColWidth}"/>
                <ColumnDefinition Width="{StaticResource SecColWidth}"/>
                <ColumnDefinition Width="{StaticResource ThdColWidth}"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============= HEADER ============= -->
            <TextBlock 
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Grid.Row="0"
                Text="Others"
                Foreground="{StaticResource TextForegroundBrush}"
                FontSize="{StaticResource ElementFontSize}"
                Margin="{StaticResource NewCategoryMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <!-- ============= HIGHSCORE_RESET ============= -->
            <TextBlock Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Grid.Row="1"
                           Text="Highscore Reset"
                           Foreground="{StaticResource TextForegroundBrush}"
                           FontSize="{StaticResource ElementFontSize}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />

            <TextBlock Grid.Column="3"
                           Grid.Row="1"
                           Text="upcoming"
                           Foreground="{StaticResource TextForegroundBrush}"
                           FontSize="{StaticResource ElementFontSize}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />

            <!-- ============= SAVE_SETTINGS ============= -->
            <TextBlock Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Grid.Row="2"
                           Text="Save Settings"
                           Foreground="{StaticResource TextForegroundBrush}"
                           FontSize="{StaticResource ElementFontSize}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />

            <TextBlock Grid.Column="3"
                           Grid.Row="2"
                           Text="upcoming"
                           Foreground="{StaticResource TextForegroundBrush}"
                           FontSize="{StaticResource ElementFontSize}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
        </Grid>
    </Grid>
</UserControl>
