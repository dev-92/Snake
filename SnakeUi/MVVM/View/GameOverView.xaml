<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SnakeUi.MVVM.View.GameOverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeUi.MVVM.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="{StaticResource ContentMarginForCustomBar}" 
          Background="{StaticResource ViewBackgroundBrush}">
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="300"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock 
                Grid.Column="0"
                Grid.Row="0"
                Text="Game Over"
                Foreground="{StaticResource TextForegroundBrush}"
                FontSize="{StaticResource HeaderFontSize}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            </TextBlock>

            <StackPanel 
                Grid.Column="0"
                Grid.Row="1"
                Orientation="Vertical">
                
                <Button 
                     Content="Try Again"
                     Click="TryAgain_Click"
                     Background="{StaticResource ButtonBackgroundBrush}"
                     Foreground="{StaticResource TextForegroundBrush}"
                     FontSize="{StaticResource ElementFontSize}"
                     Margin="0,25"
                     Width="{StaticResource ButtonWidth}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                    
                </Button>

                <Button 
                     Content="MainMenu"
                     Click="MainMenu_Click"
                     Background="{StaticResource ButtonBackgroundBrush}"
                     Foreground="{StaticResource TextForegroundBrush}"
                     FontSize="{StaticResource ElementFontSize}"
                     Width="{StaticResource ButtonWidth}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                </Button>

            </StackPanel>
           
        </Grid>
    </Grid>
</UserControl>
