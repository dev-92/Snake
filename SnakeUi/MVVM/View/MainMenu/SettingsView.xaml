<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SnakeUi.MVVM.View.MainMenu.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeUi.MVVM.View.MainMenu"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Thickness x:Key="SettingsElementMargin">5,0,5,0</Thickness>
    </UserControl.Resources>

    <Grid Margin="{StaticResource ContentMarginForCustomBar}"
          Background="{StaticResource ViewBackgroundBrush}">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="365"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock 
            Grid.Column="0"
            Grid.Row="0"
            Text="Settings"
            Foreground="{StaticResource TextForegroundBrush}"
            FontSize="{StaticResource HeaderFontSize}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        </TextBlock>

        <StackPanel 
            Orientation="Vertical"
            Grid.Column="0"
            Grid.Row="1">

            <!--  Themes  -->
            <StackPanel 
                 Orientation="Horizontal"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

                <TextBlock 
                    Text="Theme"
                    Foreground="{StaticResource TextForegroundBrush}"
                    FontSize="{StaticResource ElementFontSize}"
                    Margin="{StaticResource SettingsElementMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                </TextBlock>

                <ComboBox x:Name="ThemeSelector"
                          Width="150"
                          Height="40"
                          Foreground="{StaticResource TextForegroundBrush}"
                          FontSize="{StaticResource ComboBoxFontSize}"
                          Background="{StaticResource ComboBoxBackgroundBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          SelectionChanged="ThemeSelector_SelectionChanged">
                    <ComboBoxItem Content="Dark" />
                    <ComboBoxItem Content="Light" />
                </ComboBox>
            </StackPanel>


            <!--  Music volume slider  -->
            <StackPanel 
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock 
                    Text="Music vol"
                    Foreground="{StaticResource TextForegroundBrush}"
                    FontSize="{StaticResource ElementFontSize}"
                    Margin="{StaticResource SettingsElementMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                </TextBlock>

                <Slider
                    x:Name="MusicSlider"
                    Minimum="0"
                    Maximum="100"
                    Margin="{StaticResource SettingsElementMargin}"
                    Value="{x:Bind MusicVol, Mode=TwoWay}"
                    TickFrequency="10"
                    TickPlacement="BottomRight"
                    StepFrequency="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="200"
                    ValueChanged="MusicSlider_ValueChanged"/>

                <TextBlock 
                    Text="{x:Bind MusicVol, Mode=OneWay}"
                    Foreground="{StaticResource TextForegroundBrush}"
                    FontSize="{StaticResource ElementFontSize}"
                    Width="100"
                    Margin="{StaticResource SettingsElementMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                </TextBlock>
            </StackPanel>

            
            <!--  Effect volume slider  -->
            <StackPanel 
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock 
                    Text="Effect vol"
                    Foreground="{StaticResource TextForegroundBrush}"
                    FontSize="{StaticResource ElementFontSize}"
                    Margin="{StaticResource SettingsElementMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                </TextBlock>

                <Slider
                    x:Name="EffectSlider"
                    Minimum="0"
                    Maximum="100"
                    Margin="{StaticResource SettingsElementMargin}"
                    Value="{x:Bind EffectVol, Mode=TwoWay}"
                    TickFrequency="10"
                    TickPlacement="BottomRight"
                    StepFrequency="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="200"
                    ValueChanged="EffectSlider_ValueChanged"/>

                <TextBlock 
                    Text="{x:Bind EffectVol, Mode=OneWay}"
                    Foreground="{StaticResource TextForegroundBrush}"
                    FontSize="{StaticResource ElementFontSize}"
                    Width="100"
                    Margin="{StaticResource SettingsElementMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                </TextBlock>
            </StackPanel>

            <Button 
                Content="Back"
                Click="Back_Click"
                Style="{StaticResource CustomButtonStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
            </Button>

        </StackPanel>

    </Grid>
</UserControl>
