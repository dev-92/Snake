<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SnakeUi.MVVM.View.InfoboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeUi.MVVM.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <x:Double x:Key="InfoFontSize">28</x:Double>
        <x:Double x:Key="ValueFontSize">28</x:Double>
        <CornerRadius x:Key="CornerRadius">10</CornerRadius>
        <Thickness x:Key="ImageMargin">50,0,0,0</Thickness>
        <Thickness x:Key="ValueMargin">30,0,0,0</Thickness>
        <SolidColorBrush x:Key="BorderBackground" Color="#2f3640" />
        <SolidColorBrush x:Key="LabelTextColor" Color="#7f8fa6" />
        <SolidColorBrush x:Key="ValueTextColor" Color="#dcdde1" />
    </UserControl.Resources>

    <Grid Margin="0,0,0,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Speedfactor -->
        <Border
            Grid.Column="0"
            Grid.Row="0"
            CornerRadius="{StaticResource CornerRadius}"
            Background="{StaticResource BorderBackground}"
            Margin="0,0,5,0">

            <StackPanel Orientation="Horizontal">
                <Image
                    Source="/Assets/Infoboard/speed.png"
                    Width="30"
                    Height="30"
                    Margin="{StaticResource ImageMargin}"/>

                <TextBlock 
                    FontSize="{StaticResource ValueFontSize}"
                    Margin="{StaticResource ValueMargin}"
                    Foreground="{StaticResource ValueTextColor}"
                    Text="{x:Bind InfoboardModel.SpeedFactor , Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- Score -->
        <Border
            Grid.Column="1"
            Grid.Row="0"
            CornerRadius="{StaticResource CornerRadius}"
            Background="{StaticResource BorderBackground}"
            Margin="0,0,5,0">
            <StackPanel Orientation="Horizontal">
                
                <Image
                    Source="/Assets/Infoboard/score.png"
                    Width="30"
                    Height="30"
                    Margin="{StaticResource ImageMargin}" 
                    />

                <TextBlock 
                    FontSize="{StaticResource ValueFontSize}"
                    Margin="{StaticResource ValueMargin}"
                    Foreground="{StaticResource ValueTextColor}"
                    Text="{x:Bind InfoboardModel.Score , Mode=OneWay}" />
                
            </StackPanel>
        </Border>

        <!-- LengthOfSnake -->
        <Border
            Grid.Column="2"
            Grid.Row="0"
            CornerRadius="{StaticResource CornerRadius}"
            Background="{StaticResource BorderBackground}"
            Margin="0,0,5,0">
            <StackPanel Orientation="Horizontal">
                
                <Image
                    Source="/Assets/Infoboard/length.png"
                    Width="40"
                    Height="40"
                    Margin="{StaticResource ImageMargin}" />
                
                <TextBlock 
                    FontSize="{StaticResource ValueFontSize}"
                    Margin="{StaticResource ValueMargin}"
                    Foreground="{StaticResource ValueTextColor}"
                    Text="{x:Bind InfoboardModel.LengthOfSnake , Mode=OneWay}" />
                
            </StackPanel>
        </Border>

        <!-- HighScore -->
        <Border
            Grid.Column="3"
            Grid.Row="0"
            CornerRadius="{StaticResource CornerRadius}"
            Background="{StaticResource BorderBackground}">
            <StackPanel Orientation="Horizontal">
                
                <Image
                    Source="/Assets/Infoboard/crown.png"
                    Width="30"
                    Height="30"
                    Margin="{StaticResource ImageMargin}"/>

                <TextBlock 
                    FontSize="{StaticResource ValueFontSize}"
                    Margin="{StaticResource ValueMargin}"
                    Foreground="{StaticResource ValueTextColor}"
                    Text="---" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
