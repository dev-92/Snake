<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SnakeUi.MVVM.View.InfoboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeUi.MVVM.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <x:Double x:Key="ValueFontSize">32</x:Double>
        <CornerRadius x:Key="CornerRadius">10</CornerRadius>
        <Thickness x:Key="IconTextMargin">15,0,0,0</Thickness>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="{StaticResource GlobalWindowWidth}" 
              Height="{StaticResource InfoboardHeight}" 
              Margin="0,10,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============= SPEED_FACTOR ============= -->
            <Border Grid.Column="0" 
                    CornerRadius="{StaticResource CornerRadius}"
                    Background="{StaticResource ButtonBackgroundBrush}"
                    Margin="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/Infoboard/speed.png" Width="35" Height="35" />
                    <TextBlock FontSize="{StaticResource ValueFontSize}"
                               Margin="{StaticResource IconTextMargin}"
                               Foreground="{StaticResource TextForegroundBrush}"
                               VerticalAlignment="Center"
                               Text="{x:Bind InfoboardModel.SpeedFactor, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- ============= SCORE ============= -->
            <Border Grid.Column="1" 
                    CornerRadius="{StaticResource CornerRadius}"
                    Background="{StaticResource ButtonBackgroundBrush}"
                    Margin="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/Infoboard/score.png" Width="35" Height="35" />
                    <TextBlock FontSize="{StaticResource ValueFontSize}"
                               Margin="{StaticResource IconTextMargin}"
                               Foreground="{StaticResource TextForegroundBrush}"
                               VerticalAlignment="Center"
                               Text="{x:Bind InfoboardModel.Score, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- ============= LENGTH_OF_SNAKE ============= -->
            <Border Grid.Column="2" 
                    CornerRadius="{StaticResource CornerRadius}"
                    Background="{StaticResource ButtonBackgroundBrush}"
                    Margin="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/Infoboard/length.png" Width="45" Height="45" />
                    <TextBlock FontSize="{StaticResource ValueFontSize}"
                               Margin="{StaticResource IconTextMargin}"
                               Foreground="{StaticResource TextForegroundBrush}"
                               VerticalAlignment="Center"
                               Text="{x:Bind InfoboardModel.LengthOfSnake, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- ============= HIGHSCORE ============= -->
            <Border Grid.Column="3" 
                    CornerRadius="{StaticResource CornerRadius}"
                    Background="{StaticResource ButtonBackgroundBrush}"
                    Margin="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/Infoboard/crown.png" Width="35" Height="35" />
                    <TextBlock FontSize="{StaticResource ValueFontSize}"
                               Margin="{StaticResource IconTextMargin}"
                               Foreground="{StaticResource TextForegroundBrush}"
                               VerticalAlignment="Center"
                               Text="---" />
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>