<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BaseColors -->
    <SolidColorBrush x:Key="ViewBackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="TextForegroundBrush" Color="{StaticResource ForegroundColor}" />

    <!-- Grid / Cells -->
    <SolidColorBrush x:Key="EmptyCellBrush" Color="{StaticResource GridCellEmpty}" />
    <SolidColorBrush x:Key="CollectableCellBrush" Color="{StaticResource GridCellCollectable}" />
    <SolidColorBrush x:Key="SnakeCellBrush" Color="{StaticResource GridCellSnake}" />

    <!-- CustomBar -->
    <SolidColorBrush x:Key="CustomBarBackgroundBrush" Color="{StaticResource CustomBarBackgroundColor}" />
    
    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource ButtonPressedColor}" />

    <!-- ComboBox -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="{StaticResource ComboBoxBackgroundColor}" />
    <SolidColorBrush x:Key="ComboBoxHoverBrush" Color="{StaticResource ComboBoxHoverColor}" />
    <SolidColorBrush x:Key="ComboBoxSelectedBrush" Color="{StaticResource ComboBoxSelectedColor}" />
    <SolidColorBrush x:Key="ComboBoxDisabledBrush" Color="{StaticResource ComboBoxDisabledColor}" />

</ResourceDictionary>
