<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BaseColors -->
    <Color x:Key="BackgroundColor">#F0F0FF</Color>
    <Color x:Key="ForegroundColor">#1E1E2F</Color>
    <Color x:Key="ButtonColor">#D0D0FF</Color>

    <!-- Grid / Cells -->
    <Color x:Key="GridCellEmpty">#ECECEC</Color>
    <Color x:Key="GridCellCollectable">#B0C4DE</Color>
    <Color x:Key="GridCellSnake">#2E8B57</Color>

    <!-- CustomBar -->
    <Color x:Key="CustomBarBackgroundColor">#D0D0FF</Color>
    
</ResourceDictionary>
