<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BaseColors -->
    <Color x:Key="BackgroundColor">#101217</Color>
    <Color x:Key="ForegroundColor">#E0F7FA</Color>

    <!-- Grid / Cells -->
    <Color x:Key="GridCellEmpty">#1B1D26</Color>
    <Color x:Key="GridCellCollectable">#FF6B6B</Color>
    <Color x:Key="GridCellSnake">#00D4FF</Color>

    <!-- CustomBar -->
    <Color x:Key="CustomBarBackgroundColor">#1B1D26</Color>

    <!-- Button States -->
    <Color x:Key="ButtonColor">#263238</Color>
    <Color x:Key="ButtonHoverColor">#37474F</Color>
    <Color x:Key="ButtonPressedColor">#00D4FF</Color>

    <!-- ComboBox States -->
    <Color x:Key="ComboBoxBackgroundColor">#263238</Color>
    <Color x:Key="ComboBoxHoverColor">#37474F</Color>
    <Color x:Key="ComboBoxSelectedColor">#FF6B6B</Color>
    <Color x:Key="ComboBoxDisabledColor">#555B62</Color>

</ResourceDictionary>
