<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BaseColors -->
    <Color x:Key="BackgroundColor">#1E1E2F</Color>
    <Color x:Key="ForegroundColor">#E0E0E0</Color>

    <!-- Grid / Cells -->
    <Color x:Key="GridCellEmpty">#2A2A3D</Color>
    <Color x:Key="GridCellCollectable">#7F8C8D</Color>
    <Color x:Key="GridCellSnake">#76FF03</Color>

    <!-- CustomBar -->
    <Color x:Key="CustomBarBackgroundColor">#2A2A3D</Color>

    <!-- Button States -->
    <Color x:Key="ButtonColor">#3B3B55</Color>
    <Color x:Key="ButtonHoverColor">#505070</Color>
    <Color x:Key="ButtonPressedColor">#7878A0</Color>

    <!-- ComboBox States -->
    <Color x:Key="ComboBoxBackgroundColor">#3B3B55</Color>
    <Color x:Key="ComboBoxHoverColor">#505070</Color>
    <Color x:Key="ComboBoxSelectedColor">#606090</Color>
    <Color x:Key="ComboBoxDisabledColor">#505050</Color>

</ResourceDictionary>
