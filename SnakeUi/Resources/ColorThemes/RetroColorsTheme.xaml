<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BaseColors -->
    <Color x:Key="BackgroundColor">#1B1B2F</Color>
    <Color x:Key="ForegroundColor">#FFFA65</Color>

    <!-- Grid / Cells -->
    <Color x:Key="GridCellEmpty">#2E2E4D</Color>
    <Color x:Key="GridCellCollectable">#FF6EC7</Color>
    <Color x:Key="GridCellSnake">#00FFA3</Color>

    <!-- CustomBar -->
    <Color x:Key="CustomBarBackgroundColor">#3A3A6E</Color>

    <!-- Button States -->
    <Color x:Key="ButtonColor">#FF3D81</Color>
    <Color x:Key="ButtonHoverColor">#FF69A5</Color>
    <Color x:Key="ButtonPressedColor">#D43C70</Color>

    <!-- ComboBox States -->
    <Color x:Key="ComboBoxBackgroundColor">#FF3D81</Color>
    <Color x:Key="ComboBoxHoverColor">#FF69A5</Color>
    <Color x:Key="ComboBoxSelectedColor">#FFB347</Color>
    <Color x:Key="ComboBoxDisabledColor">#55557A</Color>

</ResourceDictionary>
