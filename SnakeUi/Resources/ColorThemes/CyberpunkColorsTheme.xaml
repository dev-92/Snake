<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BaseColors -->
    <Color x:Key="BackgroundColor">#0F0B1A</Color>
    <Color x:Key="ForegroundColor">#F0F0FF</Color>

    <!-- Grid / Cells -->
    <Color x:Key="GridCellEmpty">#1A112B</Color>
    <Color x:Key="GridCellCollectable">#FF00FF</Color>
    <Color x:Key="GridCellSnake">#BB00FF</Color>

    <!-- CustomBar -->
    <Color x:Key="CustomBarBackgroundColor">#1A112B</Color>

    <!-- Button States -->
    <Color x:Key="ButtonColor">#2B1A40</Color>
    <Color x:Key="ButtonHoverColor">#3C2A60</Color>
    <Color x:Key="ButtonPressedColor">#FF00FF</Color>

    <!-- ComboBox States -->
    <Color x:Key="ComboBoxBackgroundColor">#2B1A40</Color>
    <Color x:Key="ComboBoxHoverColor">#3C2A60</Color>
    <Color x:Key="ComboBoxSelectedColor">#FF66FF</Color>
    <Color x:Key="ComboBoxDisabledColor">#5A4C66</Color>

</ResourceDictionary>
