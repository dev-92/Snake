<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SnakeUi.MVVM.View.InfoboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeUi.MVVM.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <x:Double x:Key="InfoFontSize">24</x:Double>
        <x:Double x:Key="ValueFontSize">28</x:Double>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!--  Speedfactor  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            FontSize="{StaticResource InfoFontSize}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="Speed">
        </TextBlock>
        
        <TextBlock 
            Grid.Row="1"
            Grid.Column="0"
            FontSize="{StaticResource ValueFontSize}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{x:Bind InfoboardViewModel.SpeedFactor , Mode=OneWay}">
        </TextBlock>

        <!--  Score  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            FontSize="{StaticResource InfoFontSize}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="Score">
        </TextBlock>
        
        <TextBlock 
            Grid.Row="1"
            Grid.Column="1"
            FontSize="{StaticResource ValueFontSize}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{x:Bind InfoboardViewModel.Score , Mode=OneWay}">
        </TextBlock>

        <!--  LengthOfSnake  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="2"
            FontSize="{StaticResource InfoFontSize}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="Length">
        </TextBlock>
        
        <TextBlock 
            Grid.Row="1"
            Grid.Column="2"
            FontSize="{StaticResource ValueFontSize}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{x:Bind InfoboardViewModel.LengthOfSnake , Mode=OneWay}">
        </TextBlock>

    </Grid>
</UserControl>
