<Window
    x:Class="SnakeWinUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SnakeWinUi.MVVM.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SnakeWinUi">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowLayout" KeyDown="CoreWindow_KeyDown">
        
        <!-- Custom TitleBar -->
        <Grid 
            x:Name="CustomTitleBar" 
            Height="32" 
            Background="#222" 
            VerticalAlignment="Top"
            >
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0">
                <Image 
                    Source="Assets/snake_icon.ico" 
                    Width="40" 
                    Height="40"
                    />

                <TextBlock 
                    Text="Snake" 
                    Foreground="White" 
                    FontSize="16" 
                    VerticalAlignment="Center" 
                    Margin="8,0,0,0"
                    />
            </StackPanel>
        </Grid>

        <local:GamePage x:Name="GamePageInstance" Margin="10,40,10,10"></local:GamePage>
        
    </Grid>
</Window>
